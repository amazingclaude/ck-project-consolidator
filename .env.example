# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# Azure Blob Storage connection string
# Found in Azure Portal → Storage Account → Access Keys
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net
# Blob container name (will be auto-created if it does not exist)
AZURE_STORAGE_CONTAINER=plans

# Local assumptions file. Copy data/assumptions.example.json to this path and fill in real values.
ASSUMPTIONS_PATH=data/assumptions.json

# Azure SQL Database (optional — enables the per-plan CAPEX SQL module)
# Format: Driver={ODBC Driver 18 for SQL Server};Server=tcp:YOUR_SERVER.database.windows.net,1433;Database=YOUR_DB;Uid=YOUR_USER;Pwd=YOUR_PASSWORD;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30
# Run db_schema.sql once against the database before using the SQL module.
AZURE_SQL_CONNECTION_STRING=

# Azure AI Foundry project agent
# Uses DefaultAzureCredential, so sign in with Azure CLI or run with managed identity.
# Use either the base endpoint plus deployment name, or paste a full chat/completions endpoint.
AI_FOUNDRY_ENDPOINT=
AI_FOUNDRY_API_KEY=
AI_FOUNDRY_DEPLOYMENT=
AI_FOUNDRY_AGENT_NAME=
AI_FOUNDRY_AGENT_VERSION=
AI_FOUNDRY_API_VERSION=2024-05-01-preview

# MPP Converter Storage Account and Containers
AZURE_STORAGE_CONNECTION_STRING_MPP_CONVERTER=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_MPP_CONVERTER_IN=mppinputnew
AZURE_STORAGE_CONTAINER_MPP_CONVERTER_OUT=mppoutputnew
